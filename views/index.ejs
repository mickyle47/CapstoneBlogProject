<%- include("partials/header.ejs") %>

<section class="hero">
  <h1>Your Posts</h1>
  <p>Write, edit and share your thoughts.</p>
</section>

<% if (posts.length === 0) { %>
  <div class="empty-state">
    <h2>No posts yet</h2>
    <p>Start your blog by writing your first post.</p>
    <a class="btn btn-primary" href="/new">Create a post</a>
  </div>
<% } else { %>
  <div class="post-grid">
    <% posts.forEach(post => { %>
      <article class="post-card">
        <h2 class="post-title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
        <p class="post-meta">
          By <%= post.author %> &middot; <%= post.createdAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %>
        </p>
        <p class="post-excerpt"><%= post.content.length > 160 ? post.content.slice(0, 160) + "…" : post.content %></p>
        <div class="post-actions">
          <a class="btn btn-outline-primary btn-sm" href="/posts/<%= post.id %>">Read</a>
          <a class="btn btn-outline-secondary btn-sm" href="/posts/<%= post.id %>/edit">Edit</a>
          <form action="/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Delete this post?');">
            <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include("partials/footer.ejs") %>
